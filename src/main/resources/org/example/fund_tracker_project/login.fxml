<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            stylesheets="@login.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fund_tracker_project.controller.LoginController">

    <children>
        <VBox alignment="CENTER"
              spacing="18.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              styleClass="root-container">

            <children>
                <Label text="Fund Tracker Project" styleClass="project-title"/>

                <VBox alignment="CENTER" spacing="12.0" maxWidth="340.0" styleClass="form-box">
                    <padding>
                        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                    </padding>

                    <children>
                        <TextField fx:id="txtEmail"
                                   promptText="Introduce tu email"
                                   prefWidth="280.0"
                                   prefHeight="42.0"
                                   styleClass="input-field"/>

                        <PasswordField fx:id="txtPassword"
                                       promptText="Introduce tu contraseña"
                                       prefWidth="280.0"
                                       prefHeight="42.0"
                                       styleClass="input-field"/>

                        <Button fx:id="btnLogin"
                                text="Iniciar sesión"
                                prefWidth="280.0"
                                prefHeight="42.0"
                                styleClass="login-button"/>

                        <Label fx:id="lblMensaje"
                               text=""
                               visible="false"
                               managed="false"
                               wrapText="true"
                               styleClass="error-label"/>

                        <Hyperlink fx:id="linkRegistro"
                                   text="¿Eres nuevo? Regístrate aquí"
                                   styleClass="register-link"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>