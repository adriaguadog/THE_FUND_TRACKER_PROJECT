<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane minHeight="0.0" minWidth="0.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fund_tracker_project.controller.UsuarioController"
            styleClass="root-container"
            stylesheets="@login.css">

    <children>
        <VBox AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              spacing="20.0"
              styleClass="main-wrapper"
              fillWidth="true">

            <padding>
                <Insets top="32.0" right="40.0" bottom="32.0" left="40.0"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
                    <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblSaludo" text="Hola, Adriana" styleClass="welcome-label"/>
                                <Label fx:id="lblSubtitulo" text="Resumen de tu cartera" styleClass="subtitle-label"/>
                            </children>
                        </VBox>

                        <Hyperlink fx:id="linkCerrarSesion" text="Cerrar sesión" styleClass="logout-link"/>
                    </children>
                </HBox>

                <HBox spacing="16.0" styleClass="metrics-row" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox styleClass="metric-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Valor total" styleClass="metric-title"/>
                                <Label fx:id="lblValorTotal" text="0,00 €" styleClass="metric-value"/>
                            </children>
                        </VBox>

                        <VBox styleClass="metric-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Rentabilidad acumulada" styleClass="metric-title"/>
                                <Label fx:id="lblRentabilidadAcumulada" text="0,00 %" styleClass="metric-value"/>
                            </children>
                        </VBox>

                        <VBox styleClass="metric-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Rentabilidad YTD" styleClass="metric-title"/>
                                <Label fx:id="lblRentabilidadYtd" text="0,00 %" styleClass="metric-value"/>
                            </children>
                        </VBox>

                        <VBox styleClass="metric-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Fondos" styleClass="metric-title"/>
                                <Label fx:id="lblNumFondos" text="0" styleClass="metric-value"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS" styleClass="content-area" prefHeight="500.0">
                    <children>
                        <VBox spacing="12.0" prefWidth="764.0" minWidth="764.0" maxWidth="764.0"
                              VBox.vgrow="ALWAYS" styleClass="panel-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" styleClass="panel-header">
                                    <children>
                                        <Label text="Tu cartera" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnAddFondo" text="+" styleClass="add-button"/>
                                    </children>
                                </HBox>

                                <!-- NUEVO: StackPane que apila tabla (abajo) y buscador (encima) -->
                                <StackPane VBox.vgrow="ALWAYS">
                                    <children>

                                        <!-- La tabla va PRIMERA: es la capa inferior -->
                                        <TableView fx:id="tblCartera" styleClass="cartera-table">
                                            <columns>
                                                <TableColumn fx:id="colFondo" text="Fondo"/>
                                                <TableColumn fx:id="colParticipaciones" text="Participaciones" />
                                                <TableColumn fx:id="colPrecio" text="Precio"/>
                                                <TableColumn fx:id="colRentabilidadAcumulada" text="Rent. acumulada"/>
                                                <TableColumn fx:id="colRentabilidadYtd" text="Rent. YTD"/>
                                            </columns>
                                        </TableView>

                                        <!-- El buscador va DESPUÉS: flota por encima de la tabla -->
                                        <StackPane fx:id="stackBuscador"
                                                   visible="false"
                                                   maxWidth="720.0"
                                                   maxHeight="380.0"
                                                   styleClass="buscador-overlay"
                                                   StackPane.alignment="TOP_CENTER">
                                            <StackPane.margin>
                                                <Insets top="8.0"/>
                                            </StackPane.margin>
                                            <children>
                                                <VBox spacing="8.0">
                                                    <children>
                                                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                            <children>
                                                                <TextField fx:id="txtBuscarActivo"
                                                                           promptText="Buscar fondo por nombre o ticker..."
                                                                           styleClass="buscador-activos"
                                                                           HBox.hgrow="ALWAYS"/>
                                                                <Button fx:id="btnCerrarBuscador" text="✕" styleClass="close-button"/>
                                                            </children>
                                                        </HBox>

                                                        <ListView fx:id="listViewActivos"
                                                                  VBox.vgrow="ALWAYS"
                                                                  styleClass="overlay-list"/>
                                                        <HBox alignment="CENTER">
                                                            <children>
                                                                <Button fx:id="btnNuevoFondo" text="Nuevo fondo"
                                                                        maxWidth="200.0" styleClass="secondary-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </StackPane>

                                    </children>
                                </StackPane>
                            </children>
                        </VBox>

                        <VBox spacing="12.0" minWidth="420.0" HBox.hgrow="ALWAYS"
                              VBox.vgrow="ALWAYS" styleClass="panel-card">
                            <children>
                                <Label text="Evolución de la rentabilidad" styleClass="panel-title"/>
                                <VBox fx:id="chartContainer" VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>